[Desktop Entry]
Type=Application
Name=TextCraft
GenericName=Text Editor
Comment=A fast, modern text and Markdown editor
Exec=textcraft %F
Icon=com.github.rsxdalv.TextCraft
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;
